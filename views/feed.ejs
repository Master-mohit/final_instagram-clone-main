      var avatar = document.getElementById("story-avatar");
      var delBtn = document.getElementById("story-delete");
      var DURATION = 5000;
      var gi = 0, si = 0, timer = null;

      function ago(t) {
        var m = Math.floor((Date.now() - new Date(t)) / 60000);
        if (m < 1) return "now";
        if (m < 60) return m + "m";
        return Math.floor(m / 60) + "h";
      }

      function openViewer(index) {
        gi = index; si = 0;
        viewer.classList.remove("hidden");
        viewer.classList.add("flex");
        document.body.style.overflow = "hidden";
