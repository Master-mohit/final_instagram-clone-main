        if (e.key === "ArrowLeft") prev();
      });

      // Apni story delete
      delBtn.addEventListener("click", function () {
        var item = groups[gi].items[si];
        clearTimeout(timer);
        if (!confirm("Is story ko delete karna hai?")) { show(); return; }
        fetch("/story/" + item.id, { method: "DELETE" })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.success) location.reload();
            else { alert(data.error || "Couldn't delete the story."); show(); }
          })
          .catch(function () { alert("Network error. Please try again.");   show(); });
