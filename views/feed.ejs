        document.body.style.overflow = "";
      }

      function show() {
        clearTimeout(timer);
        var g = groups[gi], item = g.items[si];
        imgEl.src = item.src;
        nameEl.textContent = g.username;
        timeEl.textContent = ago(item.time);
