      // Circle pe click
      document.querySelector(".story").addEventListener("click", function (e) {
        var btn = e.target.closest(".story-open");
        if (btn) openViewer(Number(btn.dataset.index));
      });

      // Image ke left 1/3 pe tap = back, baaki = next
      document.getElementById("story-stage").addEventListener("click", function (e) {
        var x = e.clientX / window.innerWidth;
        if (x < 0.33) prev(); else next();
      });

      document.getElementById("story-close").addEventListener("click", closeViewer);
