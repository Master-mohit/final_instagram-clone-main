<% include ./partials/header.ejs %>

<div class="w-full min-h-screen bg-zinc-900 text-white py-5">

    <div class="flex justify-between items-center px-4">
        <a class="text-sm text-blue-500" href="/profile">
            <i class="ri-arrow-left-s-line"></i> Profile
        </a>

        <h2 class="leading-none text-sm">
            Upload Post
        </h2>

        <a class="text-sm" href="/feed">
            <i class="ri-home-line"></i> Home
        </a>
    </div>

    <div class="flex flex-col items-center gap-3 mt-16">

        <div class="image w-[25vw] h-[25vw] rounded-full border-2 border-zinc-800 flex items-center justify-center overflow-hidden">
            <i class="text-5xl font-light ri-image-line"></i>
        </div>

        <button
            id="selectpic"
            type="button"
            class="text-blue-500">
            Select Picture
        </button>

    </div>

    <form
        id="uploadform"
        action="/post"
        method="POST"
        enctype="multipart/form-data"
        class="w-full px-6 py-5">

        <select name="category" class="bg-zinc-800 text-white text-sm px-3 py-2 rounded-md">
  <option value="post" <%= (typeof category !== 'undefined' && category === 'story') ? '' : 'selected' %>>Post</option>
  <option value="story" <%= (typeof category !== 'undefined' && category === 'story') ? 'selected' : '' %>>Story</option>
</select>

        <input
            id="imageinp"
            type="file"
            name="image"
            hidden>

        <textarea
            id="caption"
            name="caption"
            placeholder="Write a caption..."
            class="w-full h-24 mt-4 bg-zinc-900 border-2 border-zinc-800 rounded-md resize-none outline-none p-3"></textarea>

        <button
            type="button"
            id="generateAI"
            class="w-full bg-purple-600 py-2 rounded-md mt-3">
            🤖 Generate AI Caption
        </button>

        <input
            type="submit"
            value="Post"
            class="w-full bg-blue-500 py-2 rounded-md mt-3 cursor-pointer">

    </form>

</div>

<script>

// Select Picture

document.querySelector("#selectpic").addEventListener("click", () => {
    document.querySelector("#imageinp").click();
});


// Image Preview

document.querySelector("#imageinp").addEventListener("change", function () {

    const file = this.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onload = function (e) {

        document.querySelector(".image").innerHTML =
        `<img src="${e.target.result}" class="w-full h-full object-cover">`;

    }

    reader.readAsDataURL(file);

});


// Generate AI Caption

document.querySelector("#generateAI").addEventListener("click", async () => {

    const image = document.querySelector("#imageinp").files[0];

    if (!image) {
        alert("Please select an image first.");
        return;
    }

    const formData = new FormData();

    formData.append("image", image);

    document.querySelector("#generateAI").innerText = "Generating...";

    try {

        const response = await fetch("/generate-caption", {

            method: "POST",

            body: formData

        });

        const data = await response.json();

        document.querySelector("#caption").value = data.caption;

    } catch (err) {

        console.log(err);

        alert("Failed to generate caption.");

    }

    document.querySelector("#generateAI").innerText =
    "🤖 Generate AI Caption";

});


  (function () {
    var sel = document.querySelector('[name="category"]');
    var ai = document.getElementById("ai-caption-box");
    if (!sel || !ai) return;
    function toggle() {
      ai.style.display = sel.value === "story" ? "none" : "";
    }
    sel.addEventListener("change", toggle);
    toggle(); 
  })();

</script>

<% include ./partials/footer.ejs %>