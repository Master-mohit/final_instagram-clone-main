<% include ./partials/header.ejs %>
  <div class="w-full min-h-screen bg-zinc-900 text-white py-5">
      <div class="nav flex justify-between items-center px-4">
        <h3 class="text-lg"><%= user.username %></h3>
        <div class="icons flex gap-5">
          <a href="/upload"><i class="text-[1.4rem] ri-add-box-line"></i></a>
          <a href="/save"><i class="text-[1.4rem] ri-menu-line"></i></a>
        </div>
      </div>
      <div class="flex justify-between items-center pl-6 pr-[12vw] mt-8">
        <div class="w-[19vw] h-[19vw] bg-sky-100 rounded-full overflow-hidden">
          <img class="w-full h-full object-cover" src="/images/uploads/<%= user.picture %>" alt=""
            onerror="this.onerror=null;this.src='/images/uploads/def.png'">
        </div>
        <div class="stats flex gap-5 items-center justify-between">
          <div class="flex flex-col items-center justify-center">
            <h3><%= user.posts.length %></h3>
            <h4>Posts</h4>
          </div>
          <div class="flex flex-col items-center justify-center">
            <h3><%= user.followers.length %></h3>
            <h4>Followers</h4>
          </div>
          <div class="flex flex-col items-center justify-center">
            <h3><%= user.following.length %></h3>
            <h4>Following</h4>
          </div>
        </div>
      </div>
      <div class="dets px-6 mt-5">
        <h3 class="text-lg mb-1"><%= user.name %></h3>
        <p class="text-xs tracking-tight opacity-50"><%= user.bio ?? "You have not set anything yet, (click edit profile to set)" %></p>
      </div>
      <div class="px-6 mt-5">
        <a class="px-3 py-2 bg-zinc-800 text-xs rounded-md" href="/edit">Edit Profile</a>
      </div>
      <div class="posts w-full flex gap-1 py-2 mt-5 flex-wrap">
        <% if(user.posts.length>0){ %>
          <% user.posts.reverse().forEach(function(post){ %>
            <div class="post w-[32.5%] h-32 bg-sky-100">
              <img class="post-thumb w-full h-full object-cover cursor-pointer"
                src="/images/uploads/<%= post.picture %>" alt=""
                data-caption="<%= post.caption %>"
                data-postid="<%= post._id %>"
                onerror="this.closest('.post').style.display='none'">
            </div>
          <% }) %>
        <% } else { %>
          <div class="w-full flex justify-center items-center min-h-[20vh]">
            <small class="opacity-50">no posts yet.</small>
          </div>
        <% } %>
      </div>
  </div>

  <div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white text-3xl" aria-label="Close">
      <i class="ri-close-line"></i>
    </button>
    <div class="max-w-full max-h-full flex flex-col items-center">
      <img id="lightbox-img" class="max-w-full max-h-[80vh] object-contain rounded" src="" alt="">
      <p id="lightbox-caption" class="text-white text-sm mt-3 text-center break-words"></p>
      <button id="lightbox-delete" class="mt-4 px-4 py-2 bg-red-600 text-white text-sm rounded-md">
        <i class="ri-delete-bin-line mr-1"></i>Delete post
      </button>
    </div>
  </div>

  <script>
    (function () {
      var box = document.getElementById("lightbox");
      var img = document.getElementById("lightbox-img");
      var cap = document.getElementById("lightbox-caption");
      var delBtn = document.getElementById("lightbox-delete");
      var currentThumb = null;

      function openBox(thumb) {
        currentThumb = thumb;
        img.src = thumb.src;
        cap.textContent = thumb.dataset.caption || "";
        box.classList.remove("hidden");
        box.classList.add("flex");
        document.body.style.overflow = "hidden";
      }

      function closeBox() {
        box.classList.add("hidden");
        box.classList.remove("flex");
        img.src = "";
        currentThumb = null;
        document.body.style.overflow = "";
      }

      delBtn.addEventListener("click", function () {
        if (!currentThumb) return;
        if (!confirm("Is post ko delete karna hai? Ye wapas nahi aayegi.")) return;

        var thumb = currentThumb;
        delBtn.disabled = true;
        delBtn.textContent = "Deleting...";

        fetch("/post/" + thumb.dataset.postid, { method: "DELETE" })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.success) {
              location.reload(); // post count bhi update ho jayega
            } else {
              alert(data.error || "Delete nahi hua");
            }
          })
          .catch(function () { alert("Network error, dobara try karo"); })
          .finally(function () {
            delBtn.disabled = false;
            delBtn.innerHTML = '<i class="ri-delete-bin-line mr-1"></i>Delete post';
          });
      });

      document.addEventListener("click", function (e) {
        var thumb = e.target.closest(".post-thumb");
        if (thumb) {
          openBox(thumb);
          return;
        }
        if (e.target.closest("#lightbox-close") || e.target === box) closeBox();
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeBox();
      });
    })();
  </script>
<% include ./partials/footer.ejs %>